 namespace fs = boost::filesystem;
 
+namespace {
+
+// Copy a bundle directory into `dst` with writable permissions.
+// boost::filesystem::copy preserves the source modes: from a read-only install
+// location (e.g. the Nix store, where directories are 0555 and files 0444) the
+// copied sub-directories would not be writable (so the copy itself fails part
+// way through) and the local preset files would remain read-only (so the app
+// could never update them).
+void copy_bundle_writable(const fs::path& src, const fs::path& dst)
+{
+    for (const auto& entry : fs::recursive_directory_iterator(src)) {
+        const fs::path target = dst / entry.path().lexically_relative(src);
+        if (entry.is_directory()) {
+            if (!fs::exists(target)) {
+                fs::create_directories(target);
+                fs::permissions(
+                    target,
+                    fs::owner_all | fs::group_read | fs::group_exe | fs::others_read | fs::others_exe
+                );
+            }
+        } else if (entry.is_regular_file()) {
+            fs::copy_file(entry.path(), target, fs::copy_options::overwrite_existing);
+            fs::permissions(target, fs::owner_read | fs::owner_write | fs::group_read | fs::others_read);
+        }
+    }
+}
+
+} // namespace
